---
interface Props {
  artwork: {
    id: string;
    title: string;
    artist: string;
    medium: string;
    type: string;
    size: string;
    price: number;
    sold: boolean;
    stripeLink: string;
    image: string;
  };
}
const { artwork } = Astro.props;
---
<article class="card">
  <a href={artwork.sold ? undefined : artwork.stripeLink} class="frame" aria-label={artwork.title}>
    <img src={artwork.image} alt={`${artwork.title} by ${artwork.artist}`} loading="lazy" />
    {artwork.sold && <span class="sold-badge">Sold</span>}
  </a>
  <div class="wall-label">
    <p class="title">{artwork.title}</p>
    <p class="artist">{artwork.artist} &mdash; {artwork.medium}</p>
    <div class="meta">
      <span>{artwork.type === 'print' ? 'Print' : 'Original'} &middot; {artwork.size}</span>
      <span class={artwork.sold ? 'sold' : ''}>
        {artwork.sold ? 'Sold' : `$${artwork.price} NZD`}
      </span>
    </div>
  </div>
  {!artwork.sold && (
    <a href={artwork.stripeLink} class="btn" style="margin-top: 0.9rem; width: 100%; justify-content: center;">
      Enquire &amp; buy
    </a>
  )}
</article>

<style>
  .card { display: flex; flex-direction: column; }
  .frame {
    display: block;
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--sand-pale);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .frame:hover img { transform: scale(1.03); }
  .sold-badge {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    background: var(--linen);
    color: var(--sold-red);
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    font-weight: 600;
  }
</style>
