---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark">
      <span class="eyebrow">Waiheke Island, New Zealand</span>
      <span class="name">The Makers Collective</span>
    </a>
    <nav>
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--sand);
    padding: 1.3rem 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .wordmark {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ink);
  }
  nav {
    display: flex;
    gap: 1.8rem;
  }
  nav a {
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
  }
  nav a:hover { color: var(--gulf); }

  @media (max-width: 560px) {
    nav { gap: 1.1rem; flex-wrap: wrap; }
  }
</style>
