---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap foot-bar">
    <div>
      <p class="foot-name">The Makers Collective</p>
      <p class="foot-loc">Waiheke Island, New Zealand</p>
    </div>
    <div class="foot-links">
      <a href="mailto:hello@waihekemakers.co.nz">hello@waihekemakers.co.nz</a>
      <a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
    </div>
    <p class="foot-copy">&copy; {year} The Makers Collective</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sand);
    margin-top: 5rem;
    padding: 2.5rem 0;
  }
  .foot-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .foot-name {
    font-family: var(--font-display);
    font-style: italic;
    margin: 0;
    color: var(--ink);
  }
  .foot-loc {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .foot-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
  }
  .foot-links a { text-decoration: none; color: var(--ink-soft); }
  .foot-links a:hover { color: var(--gulf); }
  .foot-copy {
    font-size: 0.75rem;
    color: var(--sand);
    margin: 0;
  }
</style>
