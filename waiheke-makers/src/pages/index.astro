---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { artworks } from '../data/artworks.js';

const featured = artworks.filter((a) => !a.sold).slice(0, 3);
---
<Layout title="The Makers Collective — Original Art & Prints from Waiheke Island">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">A working artists' collective</span>
        <h1>Original works and prints, made on Waiheke Island.</h1>
        <p class="lede">
          The Makers Collective represents a small group of Waiheke-based painters
          and printmakers. Every original is one of a kind; every print is pulled
          in a limited run. Once a piece sells, it's gone from here for good.
        </p>
        <a href="/gallery" class="btn btn-solid">View the gallery</a>
      </div>
      <div class="hero-frame">
        <img src="/images/placeholder-1.svg" alt="Featured work from the collective" />
      </div>
    </div>
  </section>

  <hr class="rule wrap" />

  <section class="wrap">
    <div class="section-head">
      <span class="eyebrow">Currently available</span>
      <h2>From the wall this week</h2>
    </div>
    <div class="grid">
      {featured.map((artwork) => <ArtworkCard artwork={artwork} />)}
    </div>
    <p class="see-all"><a href="/gallery" class="btn">See the full gallery &rarr;</a></p>
  </section>

  <hr class="rule wrap" />

  <section class="wrap about-teaser">
    <div>
      <span class="eyebrow">Waiheke Island, New Zealand</span>
      <h2>An island known for what its hands make.</h2>
      <p>
        Vineyards, olive groves, and a coastline that draws visitors from
        overseas every summer — and a small, tight community of artists
        working quietly in studios across the island. The Makers Collective
        is how their work reaches further than the local gallery wall.
      </p>
      <a href="/about" class="btn">Read our story</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 4rem 0 3rem; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-copy .lede { max-width: 42ch; margin-top: 1rem; }
  .hero-copy .btn { margin-top: 1.5rem; }
  .hero-frame { aspect-ratio: 4 / 5; overflow: hidden; }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; }

  .section-head { margin-bottom: 2rem; }
  .section-head h2 { margin-top: 0.4rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .see-all { margin-top: 2.5rem; }

  .about-teaser { padding: 2rem 0 1rem; }
  .about-teaser > div { max-width: 60ch; }
  .about-teaser h2 { margin-top: 0.4rem; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
