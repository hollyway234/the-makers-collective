---
const artists = [
  { href: '/artists/rachel-bakker', label: 'Rachel Bakker' },
  { href: '/artists/holly-way', label: 'Holly Way' },
  { href: '/artists/hannah-lewis', label: 'Hannah Lewis' },
  { href: '/artists/claudia-leit', label: 'Claudia Leit' },
];
const rightNav = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <nav class="side">
      <div class="has-dropdown">
        <a href="/">The Makers</a>
        <div class="dropdown">
          {artists.map((artist) => (
            <a href={artist.href}>{artist.label}</a>
          ))}
        </div>
      </div>
      <a href="/gallery">All Artworks</a>
    </nav>
    <a href="/" class="wordmark">
      <img src="/images/logo.png" alt="The Makers Collective — Waiheke Island Art Collective" class="logo" />
    </a>
    <nav class="side right">
      {rightNav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    padding: 0.75rem 0;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .wordmark { display: flex; justify-content: center; }
  .logo {
    height: 168px;
    width: auto;
  }
  .side {
    display: flex;
    gap: 1.8rem;
  }
  .side.right { justify-content: flex-end; }
  nav a, .has-dropdown > a {
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  nav a:hover, .has-dropdown > a:hover { color: var(--rust); }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 0.9rem 1.1rem;
    min-width: 170px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown a { text-transform: none; letter-spacing: 0.02em; font-size: 0.85rem; }

  @media (max-width: 860px) {
    .logo { height: 100px; }
  }
  @media (max-width: 640px) {
    .bar { grid-template-columns: 1fr; justify-items: center; gap: 0.75rem; }
    .logo { height: 90px; }
    .side, .side.right { justify-content: center; flex-wrap: wrap; gap: 1rem; }
    .dropdown { left: 50%; transform: translateX(-50%) translateY(4px); }
    .has-dropdown:hover .dropdown, .has-dropdown:focus-within .dropdown { transform: translateX(-50%) translateY(0); }
  }
</style>
