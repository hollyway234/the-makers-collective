---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { artworks } from '../data/artworks.js';
---
<Layout
  title="Gallery — The Makers Collective | Waiheke Island Art & Prints"
  description="Browse original paintings and limited-edition prints from Waiheke Island artists."
>
  <section class="wrap header-block">
    <span class="eyebrow">The full collection</span>
    <h1>All artworks</h1>
    <p class="intro">
      Originals are sold once, to one buyer. Prints are pulled in limited
      runs and marked with their edition size. Sold pieces stay listed so
      you can see the collective's range — but they're no longer available.
    </p>
  </section>

  <section class="wrap">
    <div class="grid">
      {artworks.map((artwork) => <ArtworkCard artwork={artwork} />)}
    </div>
  </section>
</Layout>

<style>
  .header-block { padding: 3rem 0 2rem; }
  .header-block h1 { margin-top: 0.4rem; }
  .intro { max-width: 56ch; margin-top: 1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem 1.75rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
