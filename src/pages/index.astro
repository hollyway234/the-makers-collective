---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { artworks } from '../data/artworks.js';
---
<Layout title="The Makers Collective — Original Art & Prints from Waiheke Island">
  <section class="wrap intro">
    <span class="eyebrow">Waiheke Island, New Zealand</span>
    <h1>Recent work</h1>
    <p class="lede">
      Original paintings and limited prints from a small collective of
      Waiheke Island artists. Originals sell once; prints are pulled in
      limited runs. When a piece is gone, it's removed from the wall.
    </p>
  </section>

  <section class="wrap">
    <div class="grid">
      {artworks.map((artwork) => <ArtworkCard artwork={artwork} />)}
    </div>
  </section>
</Layout>

<style>
  .intro { padding: 3rem 0 2.5rem; max-width: 60ch; }
  .intro h1 { margin-top: 0.5rem; margin-bottom: 1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
    padding-bottom: 4rem;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
